{
  "name": "switchyard-local",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "An offline creative-asset release desk with version-bound approval and observable provider failures.",
  "engines": {
    "node": ">=22.17.0 <23 || >=24"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "server": "node --import tsx src/server/main.ts",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "demo": "node --import tsx scripts/demo.ts",
    "start": "node --import tsx src/server/main.ts",
    "check": "npm run typecheck && npm run lint && npm test && npm run build"
  },
  "dependencies": {
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "10.12.0",
    "eslint-plugin-react-hooks": "^7.0.0",
    "globals": "^17.0.0",
    "prettier": "3.9.9",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1",
    "vite": "8.3.4",
    "vitest": "5.0.3"
  },
  "license": "MIT"
}
